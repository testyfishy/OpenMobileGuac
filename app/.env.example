# Copy to .env.local (git-ignored) and fill in your own values.
# Use a low-privilege test account only. Never commit real values.
#
# Note: VITE_* variables are embedded into the built JavaScript. These are for
# local development only and must never be set for release builds.

# Base URL of a Guacamole server, including the context path.
VITE_DEV_GUAC_URL=http://guac.example.test:8080/guacamole
VITE_DEV_GUAC_USER=testuser
VITE_DEV_GUAC_PASS=change-me
