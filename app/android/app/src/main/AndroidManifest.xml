<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No Android auto-backup or device-to-device copy of app data (AUDIT #12): the
         WebView storage holds server addresses, usernames, recents and remote-screen
         thumbnails, and Keystore-wrapped secrets cannot be restored on another device
         anyway. The app has its own explicit backup (Settings › Backup), which never
         includes tokens and encrypts passwords only with a passphrase. allowBackup="false"
         stops cloud backup and adb backup; dataExtractionRules (Android 12+) also excludes
         device-to-device transfer, which allowBackup alone does not stop there. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- openmobileguac://connect?... deep links (CON-5) and the SSO app callback (SRV-7). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openmobileguac" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keep sessions connected in the background (Android only, off by default; see
             docs/release.md, "Foreground service"). From
             @capawesome-team/capacitor-android-foreground-service. Started only while the
             setting is on and at least one remote session is open. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.AndroidForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a remote desktop session that the user opened connected while the app is in the background, so the remote session is not dropped when the user switches apps or the screen turns off. Runs only while the user has turned this on and a session is open; the notification shows the session count and a Disconnect all action." />
        </service>
        <receiver
            android:name="io.capawesome.capacitorjs.plugins.foregroundservice.NotificationActionBroadcastReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <!-- Required for REST calls and the Guacamole WebSocket tunnel. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background keep-alive (setting, off by default): the foreground service, its Android 14+
         type permission, and the notification it must show (runtime prompt on Android 13+,
         asked when the user turns the setting on). The plugin holds a partial wake lock
         while the service runs, so WAKE_LOCK is required. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
